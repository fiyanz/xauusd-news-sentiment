# =============================================================================
# .env.production.example — template produksi (VPS + Docker Compose).
# Salin ke .env di server:  cp .env.production.example .env  lalu isi secret.
# JANGAN commit .env berisi secret asli. Semua placeholder di bawah WAJIB
# diganti sebelum `docker compose -f compose.yaml up -d`.
#
# compose.yaml meng-override DATABASE_URL (host db), REPO_ROOT (/app),
# SENTIMENT_SERVICE_URL (http://sentiment:8000), dan NODE_ENV (production)
# lewat blok environment — nilai di sini tetap diisi konsisten sebagai
# dokumentasi dan untuk service yang membaca env_file.
# =============================================================================

# Application Environment
NODE_ENV=production
PORT_API=4000
PORT_WEB=3000

# ---------- Database ----------
# WAJIB: password kuat acak, mis. `openssl rand -base64 24`.
# Dipakai container db (POSTGRES_PASSWORD) dan diinterpolasi ke DATABASE_URL.
POSTGRES_PASSWORD="<GANTI_DENGAN_PASSWORD_KUAT>"
# Di compose host-nya adalah service `db`, bukan localhost.
DATABASE_URL="postgres://postgres:***@db:5432/xauusd_market"

# ---------- Sentiment service ----------
# Di compose otomatis http://sentiment:8000 (network internal, tanpa auth).
SENTIMENT_SERVICE_URL="http://sentiment:8000"
# Root repo di dalam container (struktur path sama dengan repo).
REPO_ROOT="/app"
EXTERNAL_DATA_DIR=""

# ---------- Keamanan & integrasi ----------
# WAJIB: token acak panjang untuk POST /api/v1/pipeline/sync
# (header x-pipeline-token). Kosong = endpoint menolak dengan 503.
PIPELINE_SYNC_TOKEN="<GANTI_DENGAN_TOKEN_ACAK>"
# Deriv: App ID bukan secret; token opsional (market data publik).
DERIV_APP_ID=""
DERIV_API_TOKEN=""
# Origin web yang diizinkan CORS API — isi domain publik Anda.
WEB_ORIGIN="https://example.com"

# ---------- Worker ----------
INGESTION_CRON_SCHEDULE="*/15 * * * *"
# Produksi: jangan pakai mock fallback.
ENABLE_MOCK_FALLBACK=false

# ---------- API key berita (opsional, dibaca pipeline Python) ----------
NEWSAPI_AI_KEY=""
NEWS_API_KEY=""
GNEWS_API_KEY=""
