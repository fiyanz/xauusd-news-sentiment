{
  "name": "sistem-informasi-market-xauusd",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Informasi Pasar Emas (XAUUSD) & Analisis Dampak Rilis Berita - TypeScript Monorepo",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "turbo run build",
