# Application Environment
NODE_ENV=development
PORT_API=4000
PORT_WEB=3000

# Database Configuration (SQLite by default for zero-friction setup, PostgreSQL supported)
DATABASE_URL="file:./dev.db"

# Financial Market Data API Keys
ALPHA_VANTAGE_API_KEY="demo"
TWELVE_DATA_API_KEY=""
FINNHUB_API_KEY=""

# Ingestion Worker Settings
INGESTION_CRON_SCHEDULE="*/15 * * * *"
ENABLE_MOCK_FALLBACK=true
