# =============================================================================
# .env.example — salin ke .env untuk development lokal (bare-metal / bun).
# JANGAN commit .env (sudah di .gitignore). Untuk produksi lihat
# .env.production.example dan docs/deployment.md.
#
# Catatan compose: nilai DATABASE_URL, REPO_ROOT, SENTIMENT_SERVICE_URL, dan
# NODE_ENV di-override oleh compose.yaml (host db, /app, http://sentiment:8000,
# production) — nilai di bawah dipakai untuk dev tanpa Docker.
# =============================================================================

# Application Environment
NODE_ENV=development
PORT_API=4000
PORT_WEB=3000

# Database Configuration (PostgreSQL — driver postgres-js)
DATABASE_URL="postgres://postgres:***@localhost:5432/xauusd_market"
# Password Postgres untuk container db (compose). Wajib diisi kuat di produksi.
POSTGRES_PASSWORD=""

# Sentiment service HTTP (FastAPI port 8000).
# Dev lokal: http://localhost:8000; di compose otomatis http://sentiment:8000.
SENTIMENT_SERVICE_URL="http://localhost:8000"

# Repo root (dipakai sebagai fallback path data kalau cwd tidak standar).
# Di container selalu /app (di-set compose).
REPO_ROOT="."

# Direktori dataset eksternal (opsional; dipakai pipeline Python)
EXTERNAL_DATA_DIR=""

# Token wajib untuk memicu pipeline sync via API (header x-pipeline-token).
# Kosong = endpoint sync menolak (503). Isi string acak panjang di produksi.
PIPELINE_SYNC_TOKEN=""

# Deriv market data (WebSocket publik). App ID bukan secret; token opsional
# karena market data publik Deriv tidak membutuhkannya.
DERIV_APP_ID=""
DERIV_API_TOKEN=""

# Origin web yang boleh mengakses API (pisah koma untuk beberapa)
WEB_ORIGIN="http://localhost:3000"

# Ingestion Worker Settings
INGESTION_CRON_SCHEDULE="*/15 * * * *"
ENABLE_MOCK_FALLBACK=true

# API key berita (opsional, dibaca pipeline Python dari env).
# Tanpa key, pipeline memakai sumber publik/cache yang tersedia.
NEWSAPI_AI_KEY=""
NEWS_API_KEY=""
GNEWS_API_KEY=""
